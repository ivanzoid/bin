#!/bin/bash
# Wrapper for ssh AND mosh that tints the terminal background based on user@host.
# `mosh` is a symlink to this file; the script branches on its invocation name
# ($0). For mosh to a .local host it also forces IPv4, because macOS mDNS returns
# a dual A/AAAA result that hangs mosh's fake-proxy before mosh-client starts.
#
# The tint follows the macOS appearance: a light tint in light mode, a dark tint
# in dark mode, both drawn from hard-coded parallel palettes (no runtime
# generation). A background monitor keeps the tint in sync with the macOS
# appearance and re-emits the matching tint mid-session — the OSC 11 write goes
# straight to /dev/tty (Ghostty), so it reaches through mosh/tmux/zsh.
#
# The monitor reacts instantly to SIGUSR1 ("re-check appearance now") and also
# polls every SSH_TINT_POLL seconds as a fallback (default 15; set 0 to disable
# polling and rely only on SIGUSR1). Flip every live session at once with the
# companion `ssh-tint-flip` — bind it to a hotkey or an appearance-change hook.

self="$(basename "$0")"   # "ssh" or "mosh"

# ---------- HARD‑CODED LIGHT COLORS (generated once) ----------

LIGHT_COLORS=(
    "rgb:F6/F2/E6"  # Softer Warm Yellow
    "rgb:EF/F6/F2"  # Lighter Mint
    "rgb:F7/F2/F2"  # Softer Pink
    "rgb:F2/F7/F9"  # Softer Cyan
    "rgb:F3/F8/F3"  # Softer Green
    "rgb:F3/F3/F8"  # Softer Blue
    "rgb:F6/F2/F8"  # Softer Purple
    "rgb:F8/F3/EE"  # Softer Peach
)

#LIGHT_COLORS=(
#    "rgb:FF/F8/DC"  # Lighter Warm Yellow
#    "rgb:EC/FF/F8"  # Lighter Mint
#    "rgb:FF/EC/EC"  # Lighter Pink
#    "rgb:EC/FB/FF"  # Lighter Cyan
#    "rgb:F0/FF/F0"  # Lighter Green
#    "rgb:F0/F0/FF"  # Lighter Blue
#    "rgb:FA/F0/FF"  # Lighter Purple
#    "rgb:FF/F5/ED"  # Lighter Peach
#)

#LIGHT_COLORS=(
#	"rgb:F6/EE/EE"
#	"rgb:F6/F2/EE"
#	"rgb:F6/F6/EE"
#	"rgb:F2/F6/EE"
#	"rgb:EE/F6/EE"
#	"rgb:EE/F6/F2"
#	"rgb:EE/F6/F6"
#	"rgb:EE/F2/F6"
#	"rgb:EE/EE/F6"
#	"rgb:F2/EE/F6"
#	"rgb:F6/EE/F6"
#	"rgb:F6/EE/F2"
#)

# Dark-mode counterparts, index-aligned with LIGHT_COLORS (same hue families,
# very dark so the tint is a subtle cast over a near-black background). Tweak
# freely like the light ones.
DARK_COLORS=(
    "rgb:1C/18/0E"  # Warm Yellow
    "rgb:0E/1C/16"  # Mint
    "rgb:1E/12/14"  # Pink
    "rgb:0E/18/1E"  # Cyan
    "rgb:10/1C/10"  # Green
    "rgb:10/10/20"  # Blue
    "rgb:1A/10/20"  # Purple
    "rgb:20/14/0E"  # Peach
)

NUM_COLORS=${#LIGHT_COLORS[@]}

# ---------- Resolve the real backend binary (never this wrapper) ----------
resolve_backend() {
    if [[ "$self" != mosh ]]; then
        printf '%s\n' /usr/bin/ssh
        return 0
    fi
    # Find the first `mosh` in PATH that is NOT this script (the symlink).
    local d IFS=:
    for d in $PATH; do
        [[ -x "$d/mosh" ]] || continue
        [[ "$d/mosh" -ef "${BASH_SOURCE[0]}" ]] && continue   # that's us
        printf '%s\n' "$d/mosh"
        return 0
    done
    # Fallback: common install locations (Mac Homebrew, Linux brew, system).
    for d in /opt/homebrew/bin /usr/local/bin /home/linuxbrew/.linuxbrew/bin /usr/bin; do
        [[ -x "$d/mosh" && ! "$d/mosh" -ef "${BASH_SOURCE[0]}" ]] && { printf '%s\n' "$d/mosh"; return 0; }
    done
    return 1
}

REAL="$(resolve_backend)" || { echo "${self}: real ${self} binary not found" >&2; exit 127; }

# ---------- Parse ssh/mosh arguments to extract user and host ----------
parse_target() {
    local user="" host=""
    local skip_next=0
    for arg in "$@"; do
        if [[ $skip_next -eq 1 ]]; then
            skip_next=0
            continue
        fi
        case "$arg" in
            -l)
                skip_next=1
                ;;
            -p|-o|-F|-i|-J|-w|-c|-m|-E|-L|-R|-D|-O|-S|-W)
                skip_next=1
                ;;
            -*)
                ;;
            *)
                if [[ "$arg" == *"@"* ]]; then
                    user="${arg%%@*}"
                    host="${arg#*@}"
                else
                    host="$arg"
                fi
                break
                ;;
        esac
    done

    local prev_was_l=0
    for arg in "$@"; do
        if [[ $prev_was_l -eq 1 ]]; then
            user="$arg"
            prev_was_l=0
            continue
        fi
        [[ "$arg" == "-l" ]] && prev_was_l=1
    done

    [[ -z "$user" ]] && user="$USER"
    echo "$user@$host"
}

# ---------- macOS appearance ----------
# Echoes "Dark" or "Light". The global AppleInterfaceStyle key only exists in
# dark mode; its absence means light.
macos_style() {
    if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi dark; then
        echo Dark
    else
        echo Light
    fi
}

# Emit the tint matching a given appearance to the terminal (Ghostty).
apply_tint() {
    local color
    if [[ "$1" == Dark ]]; then
        color="${DARK_COLORS[$index]}"
    else
        color="${LIGHT_COLORS[$index]}"
    fi
    printf '\e]11;%s\a' "$color" >/dev/tty 2>/dev/null
}

target=$(parse_target "$@")

# mosh + .local host: force IPv4 (see header). Skip if the user already set --family.
ARGS=("$@")
if [[ "$self" == mosh && "$target" == *.local* && "$*" != *--family* ]]; then
    ARGS=(--family=inet "$@")
fi

if [[ -z "$target" || "$target" == "@" ]] || [[ ! -t 1 ]] || [[ ! -e /dev/tty ]] || [[ "$(uname -s)" != "Darwin" ]]; then
    exec "$REAL" "${ARGS[@]}"
fi

# Deterministic index based on user@host
hash=$(printf "%s" "$target" | cksum | cut -d' ' -f1)
index=$(( hash % NUM_COLORS ))

# ---------- Live appearance monitor (background) ----------
# Keep the tint in sync with the macOS appearance. Reacts instantly to SIGUSR1
# ("re-check now"); polls every SSH_TINT_POLL seconds as a fallback (0 = never).
# `ssh-tint-flip` sends SIGUSR1 to every registered monitor at once.
POLL=${SSH_TINT_POLL:-15}
TINT_DIR="/tmp/ssh-tint-${UID}"
PIDFILE=""

resync() { local now; now=$(macos_style); [[ "$now" != "$last" ]] && { apply_tint "$now"; last="$now"; }; }

monitor_appearance() {
    local last="$1"
    trap resync USR1                 # instant flip on demand
    while :; do
        if [[ "${POLL:-0}" =~ ^[0-9]+$ && "$POLL" -gt 0 ]]; then
            sleep "$POLL" & wait $!   # SIGUSR1 interrupts the sleep
        else
            sleep 2147483647 & wait $!   # idle; only SIGUSR1 wakes us
        fi
        resync
    done
}

MON_PID=""
restore_bg() {
    [[ -n "$MON_PID" ]] && kill "$MON_PID" 2>/dev/null
    [[ -n "$PIDFILE" ]] && rm -f "$PIDFILE" 2>/dev/null
    printf '\e]111\a' >/dev/tty 2>/dev/null  # reset background to default
    trap - EXIT INT TERM
}
trap restore_bg EXIT INT TERM

# Apply the initial tint for the current appearance, then start the monitor and
# register its PID so ssh-tint-flip can find it.
style=$(macos_style)
apply_tint "$style"
monitor_appearance "$style" &
MON_PID=$!
if mkdir -p "$TINT_DIR" 2>/dev/null; then
    PIDFILE="$TINT_DIR/$MON_PID"
    echo "$MON_PID" > "$PIDFILE" 2>/dev/null || PIDFILE=""
fi

# Run the real backend
"$REAL" "${ARGS[@]}"
ret=$?

restore_bg
exit $ret
