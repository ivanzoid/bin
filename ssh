#!/bin/bash
# Wrapper for ssh AND mosh that sets a light background color based on user@host.
# `mosh` is a symlink to this file; the script branches on its invocation name
# ($0). For mosh to a .local host it also forces IPv4, because macOS mDNS returns
# a dual A/AAAA result that hangs mosh's fake-proxy before mosh-client starts.
# The color list is hard-coded – no runtime generation.

self="$(basename "$0")"   # "ssh" or "mosh"

# ---------- HARD‑CODED LIGHT COLORS (generated once) ----------

LIGHT_COLORS=(
    "rgb:F6/F2/E6"  # Softer Warm Yellow
    "rgb:EF/F6/F2"  # Lighter Mint
    "rgb:F7/F2/F2"  # Softer Pink
    "rgb:F2/F7/F9"  # Softer Cyan
    "rgb:F3/F8/F3"  # Softer Green
    "rgb:F3/F3/F8"  # Softer Blue
    "rgb:F6/F2/F8"  # Softer Purple
    "rgb:F8/F3/EE"  # Softer Peach
)

#LIGHT_COLORS=(
#    "rgb:FF/F8/DC"  # Lighter Warm Yellow
#    "rgb:EC/FF/F8"  # Lighter Mint
#    "rgb:FF/EC/EC"  # Lighter Pink
#    "rgb:EC/FB/FF"  # Lighter Cyan
#    "rgb:F0/FF/F0"  # Lighter Green
#    "rgb:F0/F0/FF"  # Lighter Blue
#    "rgb:FA/F0/FF"  # Lighter Purple
#    "rgb:FF/F5/ED"  # Lighter Peach
#)

#LIGHT_COLORS=(
#	"rgb:F6/EE/EE"
#	"rgb:F6/F2/EE"
#	"rgb:F6/F6/EE"
#	"rgb:F2/F6/EE"
#	"rgb:EE/F6/EE"
#	"rgb:EE/F6/F2"
#	"rgb:EE/F6/F6"
#	"rgb:EE/F2/F6"
#	"rgb:EE/EE/F6"
#	"rgb:F2/EE/F6"
#	"rgb:F6/EE/F6"
#	"rgb:F6/EE/F2"
#)

NUM_COLORS=${#LIGHT_COLORS[@]}

# ---------- Resolve the real backend binary (never this wrapper) ----------
resolve_backend() {
    if [[ "$self" != mosh ]]; then
        printf '%s\n' /usr/bin/ssh
        return 0
    fi
    # Find the first `mosh` in PATH that is NOT this script (the symlink).
    local d IFS=:
    for d in $PATH; do
        [[ -x "$d/mosh" ]] || continue
        [[ "$d/mosh" -ef "${BASH_SOURCE[0]}" ]] && continue   # that's us
        printf '%s\n' "$d/mosh"
        return 0
    done
    # Fallback: common install locations (Mac Homebrew, Linux brew, system).
    for d in /opt/homebrew/bin /usr/local/bin /home/linuxbrew/.linuxbrew/bin /usr/bin; do
        [[ -x "$d/mosh" && ! "$d/mosh" -ef "${BASH_SOURCE[0]}" ]] && { printf '%s\n' "$d/mosh"; return 0; }
    done
    return 1
}

REAL="$(resolve_backend)" || { echo "${self}: real ${self} binary not found" >&2; exit 127; }

# ---------- Parse ssh/mosh arguments to extract user and host ----------
parse_target() {
    local user="" host=""
    local skip_next=0
    for arg in "$@"; do
        if [[ $skip_next -eq 1 ]]; then
            skip_next=0
            continue
        fi
        case "$arg" in
            -l)
                skip_next=1
                ;;
            -p|-o|-F|-i|-J|-w|-c|-m|-E|-L|-R|-D|-O|-S|-W)
                skip_next=1
                ;;
            -*)
                ;;
            *)
                if [[ "$arg" == *"@"* ]]; then
                    user="${arg%%@*}"
                    host="${arg#*@}"
                else
                    host="$arg"
                fi
                break
                ;;
        esac
    done

    local prev_was_l=0
    for arg in "$@"; do
        if [[ $prev_was_l -eq 1 ]]; then
            user="$arg"
            prev_was_l=0
            continue
        fi
        [[ "$arg" == "-l" ]] && prev_was_l=1
    done

    [[ -z "$user" ]] && user="$USER"
    echo "$user@$host"
}

# ---------- Detect the terminal's current background (skip tint on dark themes) ----------
terminal_bg_is_dark() {
    # Ask the terminal for its background color via OSC 11 and decide if it's dark.
    # Returns 0 (dark) / 1 (light or unknown). Works with Ghostty et al.
    local old_stty response
    old_stty=$(stty -g </dev/tty 2>/dev/null) || return 1
    stty raw -echo min 0 time 5 </dev/tty 2>/dev/null
    printf '\e]11;?\a' >/dev/tty
    IFS= read -r -t 1 -d $'\a' response </dev/tty 2>/dev/null
    stty "$old_stty" </dev/tty 2>/dev/null

    # Response looks like: ...]11;rgb:rrrr/gggg/bbbb  (2 or 4 hex digits per channel)
    [[ "$response" =~ rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+) ]] || return 1
    local r=$((16#${BASH_REMATCH[1]:0:2}))
    local g=$((16#${BASH_REMATCH[2]:0:2}))
    local b=$((16#${BASH_REMATCH[3]:0:2}))
    # Perceived luminance (0–255); below 128 means a dark background.
    local lum=$(( (r*299 + g*587 + b*114) / 1000 ))
    [[ $lum -lt 128 ]]
}

target=$(parse_target "$@")

# mosh + .local host: force IPv4 (see header). Skip if the user already set --family.
ARGS=("$@")
if [[ "$self" == mosh && "$target" == *.local* && "$*" != *--family* ]]; then
    ARGS=(--family=inet "$@")
fi

if [[ -z "$target" || "$target" == "@" ]] || [[ ! -t 1 ]] || [[ ! -e /dev/tty ]] || [[ "$(uname -s)" != "Darwin" ]]; then
    exec "$REAL" "${ARGS[@]}"
fi

# Don't apply a light tint when a dark terminal theme is active.
if terminal_bg_is_dark; then
    exec "$REAL" "${ARGS[@]}"
fi

# Deterministic index based on user@host
hash=$(printf "%s" "$target" | cksum | cut -d' ' -f1)
index=$(( hash % NUM_COLORS ))
bg_color="${LIGHT_COLORS[$index]}"

# ---------- Trap to restore background ----------
restore_bg() {
    printf '\e]111\a' >/dev/tty 2>/dev/null  # reset background to default
    trap - EXIT INT TERM
}
trap restore_bg EXIT INT TERM

# Apply the chosen light background
printf '\e]11;%s\a' "$bg_color" >/dev/tty 2>/dev/null

# Run the real backend
"$REAL" "${ARGS[@]}"
ret=$?

restore_bg
exit $ret
