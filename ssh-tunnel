#!/usr/bin/env bash
# Open an ssh port-forwarding tunnel (ssh -N) from a compact port spec, instead
# of spelling out one -L per port.
#
#   ssh-tunnel ivan@ai -p 8002-8012,8080-8090,9000-9010
#   ssh-tunnel -s ivan@ai -p 8000-8100       # skip local ports already in use
#   ssh-tunnel -d ivan@ai -p 3000,5432       # detach into the background
#   ssh-tunnel -n ivan@ai -p 8000-8002       # dry run: just print the command
#   ssh-tunnel ivan@ai -p 8080 -- -J bastion -i ~/.ssh/id_ed25519
#
# Port spec items, comma-separated:
#   N      local N      -> remote N
#   A-B    every port in the range, 1:1
#   L:R    local L      -> remote R
# The remote end is localhost unless -r/--remote-host names another host (that
# name is resolved on the remote side).
#
# Local listeners bind 127.0.0.1 explicitly (-b to change): left implicit, ssh
# resolves the bind address across both families and noisily fails on [::1] for
# every port on a host with IPv6 disabled. -b 0.0.0.0 exposes the forwards to
# the LAN.
#
# ssh gets ExitOnForwardFailure plus keepalives, so a port that can't bind fails
# the tunnel instead of leaving it half working. Because one busy port out of
# fifty is a miserable way to find that out, the wanted ports are checked
# against the local listeners first (ss, else lsof) and the clash is reported
# with the process holding it; -s forwards the rest instead of bailing. That
# check is advisory -- ExitOnForwardFailure still catches whatever it missed
# (no ss/lsof, a listener on another address, a race).
#
# Anything after -- is handed to ssh *before* the defaults above, so it wins:
# ssh keeps the first value it sees for an option (e.g. `-- -4`, or
# `-- -o ExitOnForwardFailure=no`).
#
# The real ssh is called directly, bypassing the `ssh` tint wrapper in this
# directory -- a background tunnel has no business recoloring the terminal.

set -euo pipefail

usage() {
    cat >&2 <<'USAGE'
usage: ssh-tunnel [-s] [-d] [-n] [-b bind-addr] [-r remote-host] [user@]host -p PORTS [-- ssh-args...]

  -p, --ports PORTS     comma-separated: N | A-B | L:R   (required)
  -s, --skip-busy       drop local ports already in use instead of failing
  -b, --bind ADDR       local bind address (default: 127.0.0.1)
  -r, --remote-host H   remote end of the forwards (default: localhost)
  -d, --detach          fork into the background (ssh -f)
  -n, --dry-run         print the ssh command instead of running it
  -h, --help            this
USAGE
}

die() { echo "ssh-tunnel: $*" >&2; exit 2; }

ssh_bin=/usr/bin/ssh
[ -x "$ssh_bin" ] || die "no ssh at $ssh_bin"

ports=""
target=""
rhost=localhost
baddr=127.0.0.1
skip_busy=0
detach=0
dry=0
extra=()

need_arg() { [ $# -ge 2 ] || die "$1 needs a value"; }

while [ $# -gt 0 ]; do
    case "$1" in
        -p | --ports)       need_arg "$@"; ports="$2"; shift 2 ;;
        -p=* | --ports=*)   ports="${1#*=}"; shift ;;
        -r | --remote-host) need_arg "$@"; rhost="$2"; shift 2 ;;
        -r=* | --remote-host=*) rhost="${1#*=}"; shift ;;
        -b | --bind)        need_arg "$@"; baddr="$2"; shift 2 ;;
        -b=* | --bind=*)    baddr="${1#*=}"; shift ;;
        -s | --skip-busy)   skip_busy=1; shift ;;
        -d | --detach)      detach=1; shift ;;
        -n | --dry-run)     dry=1; shift ;;
        -h | --help)        usage; exit 0 ;;
        --)                 shift; extra+=("$@"); break ;;
        -*)                 die "unknown option: $1 (ssh options go after --)" ;;
        *)                  [ -z "$target" ] || die "unexpected argument: $1"
                            target="$1"; shift ;;
    esac
done

[ -n "$target" ] || { usage; exit 2; }
[ -n "$ports" ] || die "no ports given (-p)"

# Expand the spec into parallel local/remote lists. `claimed` holds the local
# ports already taken (space-padded for whole-word matching) so a duplicate is
# dropped and a conflicting duplicate is an error, rather than ssh failing on
# the second bind.
locals=()
remotes=()
claimed=" "

check_port() {
    case "$1" in
        "" | *[!0-9]*) die "not a port number: '$1' (in '$2')" ;;
    esac
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ] || die "port out of range: $1 (in '$2')"
}

add() {  # add <local> <remote> <item, for messages>
    local l="$1" r="$2" item="$3" i
    check_port "$l" "$item"
    check_port "$r" "$item"
    case "$claimed" in *" $l "*)
        for i in "${!locals[@]}"; do
            [ "${locals[$i]}" = "$l" ] || continue
            [ "${remotes[$i]}" = "$r" ] && return 0
            die "local port $l mapped to both ${remotes[$i]} and $r"
        done ;;
    esac
    locals+=("$l")
    remotes+=("$r")
    claimed="$claimed$l "
}

IFS=, read -r -a items <<<"$ports"
for item in ${items[@]+"${items[@]}"}; do
    [ -n "$item" ] || continue
    case "$item" in
        *:*:*) die "too many colons in '$item' (use L:R, and -r for the remote host)" ;;
        *-*-*) die "too many dashes in '$item' (use A-B)" ;;
        *:*)   add "${item%%:*}" "${item#*:}" "$item" ;;
        *-*)
            from="${item%%-*}"; to="${item#*-}"
            check_port "$from" "$item"
            check_port "$to" "$item"
            [ "$from" -le "$to" ] || die "reversed range: '$item'"
            for ((p = from; p <= to; p++)); do add "$p" "$p" "$item"; done
            ;;
        *)     add "$item" "$item" "$item" ;;
    esac
done

[ ${#locals[@]} -gt 0 ] || die "port spec expanded to nothing: '$ports'"

# Listening TCP sockets as "port<TAB>address<TAB>command(pid)" rows. ss on
# Linux, lsof elsewhere (macOS has it out of the box); silence means "couldn't
# look", not "nothing is listening".
listeners() {
    if command -v ss >/dev/null 2>&1; then
        ss -Hlntp 2>/dev/null | awk '
            {
                addr = $4; port = addr
                sub(/.*:/, "", port); sub(/:[^:]*$/, "", addr)
                who = "?"
                if (match($0, /users:\(\("[^"]+",pid=[0-9]+/)) {
                    who = substr($0, RSTART, RLENGTH)
                    sub(/users:\(\("/, "", who); sub(/",pid=/, "(", who)
                    who = who ")"
                }
                print port "\t" addr "\t" who
            }'
    elif command -v lsof >/dev/null 2>&1; then
        # -F emits one field per line (p=pid, c=command, n=name), which beats
        # column-counting lsof's variable-width table.
        lsof -nP -iTCP -sTCP:LISTEN -F cnp 2>/dev/null | awk '
            /^p/ { pid = substr($0, 2); next }
            /^c/ { cmd = substr($0, 2); next }
            /^n/ {
                name = substr($0, 2); port = name; addr = name
                sub(/.*:/, "", port); sub(/:[^:]*$/, "", addr)
                print port "\t" addr "\t" cmd "(" pid ")"
            }'
    fi
}

# Which of the wanted local ports already have a listener on an address that
# collides with our bind address (an exact match, or a wildcard).
busy=" "
busy_rows=""
while IFS="$(printf '\t')" read -r lport laddr lwho; do
    [ -n "$lport" ] || continue
    case "$claimed" in *" $lport "*) ;; *) continue ;; esac
    case "$busy" in *" $lport "*) continue ;; esac
    if [ "$laddr" = "$baddr" ] || [ "$laddr" = '*' ] || [ "$laddr" = '0.0.0.0' ] \
        || [ "$laddr" = '[::]' ] || [ "$laddr" = '::' ]; then
        busy="$busy$lport "
        busy_rows="$busy_rows  $lport  $lwho"$'\n'
    fi
done <<<"$(listeners)"

if [ "$busy" != " " ]; then
    # ss/lsof list sockets in their own order; report ports in numeric order.
    n=$(printf '%s' "$busy" | wc -w | tr -d ' ')
    busy_list=$(printf '%s' "$busy" | tr -s ' ' '\n' | grep . | sort -n | paste -sd, -)
    if [ "$skip_busy" -eq 1 ]; then
        echo "ssh-tunnel: skipping $n busy local port(s): $busy_list" >&2
    else
        echo "ssh-tunnel: $n of ${#locals[@]} local port(s) already in use:" >&2
        printf '%s' "$busy_rows" | sort -n >&2
        die "free them, bind elsewhere (-b), or forward the rest (-s)"
    fi
fi

fwd=()
kept=0
for i in "${!locals[@]}"; do
    if [ "$skip_busy" -eq 1 ]; then
        case "$busy" in *" ${locals[$i]} "*) continue ;; esac
    fi
    fwd+=(-L "$baddr:${locals[$i]}:$rhost:${remotes[$i]}")
    kept=$((kept + 1))
done
[ "$kept" -gt 0 ] || die "every wanted port is in use; nothing left to forward"

cmd=("$ssh_bin" -N)
[ "$detach" -eq 1 ] && cmd+=(-f)
cmd+=(
    ${extra[@]+"${extra[@]}"}
    -o ExitOnForwardFailure=yes
    -o ServerAliveInterval=30
    -o ServerAliveCountMax=3
    "${fwd[@]}"
    "$target"
)

if [ "$dry" -eq 1 ]; then
    printf '%q ' "${cmd[@]}"; echo
    exit 0
fi

echo "ssh-tunnel: $target, $kept port(s) on $baddr" >&2
exec "${cmd[@]}"
