#!/usr/bin/env bash
# Start a minimal Claude Code session to anchor a 5-hour usage window.
# Intended to be triggered by cron at strategic times.

LOG="$HOME/.claude_ping.log"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M %Z')

echo "$TIMESTAMP - starting ping" >> "$LOG"

# Run a minimal prompt that uses negligible tokens
if fya -p "reply with 'ok'" --model haiku > /dev/null 2>&1; then
    echo "$TIMESTAMP - ping OK" >> "$LOG"
else
    echo "$TIMESTAMP - ping FAILED (exit $?)" >> "$LOG"
fi
