#!/bin/bash
# Ghostty Cmd+T / Cmd+N remote reconnect helper.
#
# Reads a small request file (staged by ~/.hammerspoon/ghostty-remote-tabs.lua
# right before it opens a native new tab/window) describing which host + remote
# directory to reconnect to, then launches mosh/ssh into a fresh tmux session in
# that directory. The early hook at the top of ~/.zprofile execs this *before*
# any heavy shell init runs, so a new Ghostty surface connects straight out
# without paying for a full local login shell (the old approach spun one up just
# to type a command into it, then polled for its prompt).
#
# When the remote session ends cleanly we exit too, so Ghostty closes the
# tab/window on a single Ctrl+D. Only a failed connect (e.g. mosh missing, host
# down) falls through to a local login shell, which keeps the error readable
# instead of the surface vanishing.
#
# Request file format (one field per line):
#   <epoch>       unix time the request was written (freshness gate is in ~/.zprofile)
#   <transport>   "mosh" | "ssh"
#   <host>        bare host label from the window title, e.g. "ai"
#   <dir>         remote dir (may start with ~), or empty for "no cd"
#
# Usage: ghostty-reconnect <request-file>

set -u

# ============================================================================
#  HOST RESOLUTION  —  edit /etc/hosts, not this file.
#
#  The bare host label from the window title (e.g. "ai") IS the canonical name:
#  it doubles as the tint-hash identity and the /etc/hosts key. Hosts are named
#  without a ".local" suffix on purpose — macOS routes *.local through mDNS,
#  which stalls ~5s on the dead macvlan .162 record.
#
#  The IP is deliberately NOT here — it lives solely in /etc/hosts (single
#  source of truth), read directly below so we dial a raw IP with zero name
#  lookup. To point a host at a new address, edit ONE line in /etc/hosts:
#      10.0.0.5   ai
#  The "ivan@" login is added below.
# ============================================================================
hosts_ipv4() {   # IPv4 for a name from /etc/hosts only — a file read, no resolver/mDNS
    awk -v h="$1" '
        /^[[:space:]]*#/ { next }
        $1 ~ /:/         { next }          # skip IPv6 rows
        { for (i = 2; i <= NF; i++) if ($i == h) { print $1; exit } }
    ' /etc/hosts 2>/dev/null
}

resolve_host() {   # sets globals: connect, identity
    identity="$1"                                # label == canonical name
    connect="$(hosts_ipv4 "$identity")"          # pinned IP (fast, no lookup) ...
    [[ -n "$connect" ]] || connect="$identity"   # ... else dial the name
}

# Drop to a fresh local login shell (window stays open). Never returns.
fallback() {
    if [[ -n "${GHOSTTY_RECONNECT_DEBUG:-}" ]]; then echo 'argv: [fallback login shell]'; exit 0; fi
    exec "${SHELL:-/bin/zsh}" -li
}

# Run the backend. On a clean exit (status 0) end this process too, so Ghostty
# closes the tab/window on a single Ctrl+D instead of dropping you into a local
# shell you have to exit a second time. Only a *failed* run falls through to a
# login shell, which is what the fallback is really for: a connect error (mosh
# missing, host down) stays readable instead of the surface vanishing.
#
# Caveat for ssh: its status is the *remote* command's, so a remote session that
# ends nonzero also leaves you in a local shell.
launch() {
    if [[ -n "${GHOSTTY_RECONNECT_DEBUG:-}" ]]; then printf 'argv:'; printf ' [%s]' "$@"; printf '\n'; exit 0; fi
    "$@" && exit 0
    # The identity we exported below belongs to *this* connect only. Drop it so a
    # later ssh/mosh typed into the fallback shell hashes its own target instead
    # of inheriting this host's tint color.
    unset SSH_TINT_IDENTITY
    exec "${SHELL:-/bin/zsh}" -li
}

req="${1:-}"
[[ -n "$req" && -r "$req" ]] || fallback

# Read the four fields, then remove the request so no later shell reuses it.
transport="" host="" dir=""
{ read -r _epoch; read -r transport; read -r host; read -r dir; } < "$req"
rm -f "$req" 2>/dev/null
[[ -n "$host" ]] || fallback

# .zprofile's PATH setup hasn't run yet, so make the mosh/ssh tint wrapper
# (~/bin) and the real binaries (Homebrew) findable.
export PATH="$HOME/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# Resolve the host to a dial address + a stable tint identity (see above).
# Dial the address; export the identity so the ssh/mosh tint wrapper keeps the
# per-host background color stable even when we dial a raw IP.
connect="" identity=""
resolve_host "$host"
target="ivan@$connect"
export SSH_TINT_IDENTITY="ivan@$identity"

# Remote command: best-effort cd into the dir, then exec a fresh, auto-named
# tmux session. session-name.sh lives on the remote. $HOME is left unexpanded
# here so the *remote* shell expands it (a quoted "~" would not expand).
remote_cmd='exec tmux new-session -s "$($HOME/.tmux/session-name.sh)"'
if [[ -n "$dir" ]]; then
    case "$dir" in
        "~"|"~/"*) rdir="\$HOME${dir#\~}" ;;   # ~/ha -> $HOME/ha (literal for remote)
        *)         rdir="$dir" ;;
    esac
    remote_cmd="cd \"$rdir\" 2>/dev/null; $remote_cmd"
fi

if [[ "$transport" == "ssh" ]]; then
    # ssh runs the command via the remote login shell; -t forces a PTY for tmux.
    launch ssh -t "$target" "$remote_cmd"
else
    # mosh execs the command directly (no remote shell wrapper), so invoke a
    # non-interactive login zsh: it picks up PATH, skips the tmux chooser, then
    # execs tmux. "--" before the host keeps mosh's parser off the -lc flags.
    launch mosh -- "$target" zsh -lc "$remote_cmd"
fi
